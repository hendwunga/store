# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080

# ============================================
# PRODUCTION DATABASE
# ============================================
PROD_DB_URL=jdbc:mysql://[host]:[port]/[dbname]?sslMode=REQUIRED&useUnicode=true&characterEncoding=utf8
PROD_DB_USER=your_prod_user
PROD_DB_PASSWORD=your_prod_password

# ============================================
# STAGING DATABASE
# ============================================
STAGING_DB_URL=jdbc:mysql://[host]:[port]/[dbname]?sslMode=REQUIRED&useUnicode=true&characterEncoding=utf8
STAGING_DB_USER=your_staging_user
STAGING_DB_PASSWORD=your_staging_password

# ============================================
# DEVELOPMENT DATABASE
# ============================================
DEV_DB_URL=jdbc:mysql://localhost:3306/store?useUnicode=true&characterEncoding=utf8
DEV_DB_USER=root
DEV_DB_PASSWORD=

# ============================================
# CLOUDINARY (Image Upload - Opsional)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# SWAGGER / OPENAPI CONFIGURATION
# ============================================
APP_TITLE=Store API
APP_VERSION=1.0.0
APP_DESC=REST API untuk manajemen produk dan kategori pada aplikasi Store
CONTACT_NAME=Hend Wunga
CONTACT_EMAIL=hend@example.com
LICENSE_NAME=MIT

# URL Server Swagger (Bisa disesuaikan saat deploy)
URL_LOCAL=http://localhost:8080
URL_STAGING=https://staging-store.herokuapp.com
URL_PROD=https://your-app.herokuapp.com
